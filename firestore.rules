rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Pure cryptographic JWT custom claims (Zero client document fallback, zero extra reads)
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function getUserClinicId() {
      return request.auth.token.clinicId;
    }

    function isClinicAdmin(clinicId) {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (hasRole('admin') && getUserClinicId() == clinicId)
      );
    }

    function isClinicStaff(clinicId) {
      return isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        ((hasRole('admin') || hasRole('staff')) && getUserClinicId() == clinicId)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Clinics Collection (Multi-Tenant)
    // Staff CANNOT modify theme or settings; ONLY clinic admins can update
    match /clinics/{clinicId} {
      allow read: if true;
      allow update: if isClinicAdmin(clinicId);
      allow create: if isClinicAdmin(clinicId);
      allow delete: if isAuthenticated() && request.auth.token.superAdmin == true;
    }

    // 1.5. Clinic Settings (Sensitive integrations, Stripe keys, webhook secrets)
    // ONLY authenticated Clinic Admins can read or write
    match /clinic_settings/{settingId} {
      allow read: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        isClinicAdmin(resource.data.clinicId)
      );
      allow create: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        isClinicAdmin(request.resource.data.clinicId)
      );
      allow update: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (isClinicAdmin(resource.data.clinicId) && isClinicAdmin(request.resource.data.clinicId))
      );
      allow delete: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        isClinicAdmin(resource.data.clinicId)
      );
    }

    // 1.6. Deployment Clinic Configuration (Active tenant public branding)
    // Public read so portal/signup displays active clinic branding;
    // Primary tenant ID is strictly immutable once set - only platform superAdmin can alter it.
    match /clinic_config/{configId} {
      allow read: if true;
      allow create: if false; // Provisioned exclusively via Cloud Functions
      allow update: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (
          resource != null &&
          isClinicAdmin(resource.data.primaryClinicId) &&
          request.resource.data.primaryClinicId == resource.data.primaryClinicId
        )
      );
      allow delete: if false;
    }

    // 1.7. Private Deployment Configuration (Sensitive Admin UIDs, Webhook secrets, Token hashes)
    // Strictly confidential: Not readable or writable by the public or non-admin users
    match /clinic_config_private/{configId} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (resource != null && isClinicAdmin(resource.data.primaryClinicId))
      );
    }

    // 2. Users Collection
    // Patients can only view their own profile. On self-update, role and clinicId are immutable.
    // Staff can read patient profiles; only Clinic Admins can promote roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && isClinicStaff(resource.data.clinicId));
      allow create: if isAuthenticated() && request.auth.uid == userId
                     && (!('role' in request.resource.data) || request.resource.data.role == 'patient');
      allow update: if (
        isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('clinicId' in request.resource.data) || request.resource.data.clinicId == resource.data.clinicId)
      ) || (isAuthenticated() && isClinicAdmin(resource.data.clinicId));
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // 3. Appointments Collection
    // Strict isolation:
    // - Patients can read their own appointments
    // - Clinic staff can read appointments for their clinic
    // - Public web booking creation allowed
    // - Payment status, amountPaid, and tenant/owner identities are IMMUTABLE to patient clients
    match /appointments/{appointmentId} {
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) ||
                     (isAuthenticated() && isClinicStaff(resource.data.clinicId));
      
      allow create: if true;

      allow update: if (
        // Patient update: can edit notes/intake/reschedule, but CANNOT touch payment, owner, or clinic tenant
        isAuthenticated() && resource.data.patientId == request.auth.uid &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.clinicId == resource.data.clinicId &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus) &&
        (!('amountPaid' in request.resource.data) || request.resource.data.amountPaid == resource.data.amountPaid) &&
        (!('stripePaymentIntentId' in request.resource.data) || request.resource.data.stripePaymentIntentId == resource.data.stripePaymentIntentId)
      ) || (
        // Staff update: clinic tenant remains immutable
        isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
        request.resource.data.clinicId == resource.data.clinicId
      );

      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // Patients Collection Alias (maps to Users for backward compatibility)
    match /patients/{patientId} {
      allow read: if isOwner(patientId) || (isAuthenticated() && isClinicStaff(resource.data.clinicId));
      allow create: if isOwner(patientId) || !isAuthenticated();
      allow update: if (
        isOwner(patientId) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('clinicId' in request.resource.data) || request.resource.data.clinicId == resource.data.clinicId)
      ) || (isAuthenticated() && isClinicAdmin(resource.data.clinicId));
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // 4. Inquiries / Leads Collection
    // Public can create (website contact form), but only clinic staff can read/manage
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                             request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // 5. Conditions, Team, Blogs, Testimonials, FAQs (Public Content)
    // Public read; staff can create and update ONLY within their own clinic;
    // Overwrite across clinics is strictly prevented by checking both resource and request.resource
    match /conditions/{conditionId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                       request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                       request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                       request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                       request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId) &&
                       request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // 6. Support Tickets (Scoped by clinicId)
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        resource.data.clinicId == request.auth.token.clinicId
      );
      allow create: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        request.resource.data.clinicId == request.auth.token.clinicId
      );
      allow update: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        (resource.data.clinicId == request.auth.token.clinicId && request.resource.data.clinicId == resource.data.clinicId)
      );
      allow delete: if false;
    }

    // 7. Global Announcements (Public read, no client write)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. Invoices (Scoped by clinicId & patient ownership, no client write)
    // Patients can only read invoices issued to them; staff can read all invoices for their clinic
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        request.auth.token.superAdmin == true ||
        isClinicStaff(resource.data.clinicId) ||
        (resource.data.patientId == request.auth.uid && resource.data.clinicId == getUserClinicId())
      );
      allow write: if false;
    }

    // 9. Operator Audit Logs (Server-only via Admin SDK)
    match /operator_audit_log/{logId} {
      allow read, write: if false;
    }

    // 9.1. Transactional Slot Reservations & Rate Limiting (Server-only via Admin SDK)
    match /reservations/{reservationId} {
      allow read, write: if false;
    }

    match /clinic_notifications_ratelimit/{clinicId} {
      allow read, write: if false;
    }

    // 10. Diagnostics check collection (SuperAdmin only in production)
    match /_diag/{diagId} {
      allow read, write: if isAuthenticated() && request.auth.token.superAdmin == true;
    }
  }
}
