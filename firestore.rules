rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Pure cryptographic JWT custom claims (Zero client document fallback, zero extra reads)
    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function getUserClinicId() {
      return request.auth.token.clinicId;
    }

    function isClinicAdmin(clinicId) {
      return isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        (hasRole('admin') && getUserClinicId() == clinicId)
      );
    }

    function isClinicStaff(clinicId) {
      return isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        ((hasRole('admin') || hasRole('staff')) && getUserClinicId() == clinicId)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Clinics Collection (Multi-Tenant)
    // Staff CANNOT modify theme or settings; ONLY clinic admins can update
    match /clinics/{clinicId} {
      allow read: if true;
      allow update: if isClinicAdmin(clinicId) || (hasRole('editor') && getUserClinicId() == clinicId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customPosts','heroHook','heroSubhead','heroBadge','heroUrgentPain','customConditions','publicTeamMembers','customReviews','customFaqs','heroImage','doctorImage','clinicImage','lastActive','updatedAt']));
      allow create: if isClinicAdmin(clinicId);
      allow delete: if isAuthenticated() && request.auth.token.get('superAdmin', false) == true;
    }

    // 1.5. Clinic Settings (Sensitive integrations, Stripe keys, webhook secrets)
    // ONLY authenticated Clinic Admins can read or write
    match /clinic_settings/{settingId} {
      allow read: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicAdmin(resource.data.clinicId)
      );
      allow create: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicAdmin(request.resource.data.clinicId)
      );
      allow update: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        (isClinicAdmin(resource.data.clinicId) && isClinicAdmin(request.resource.data.clinicId))
      );
      allow delete: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicAdmin(resource.data.clinicId)
      );
    }

    // 1.6. Deployment Clinic Configuration (Active tenant public branding)
    // Public read so portal/signup displays active clinic branding;
    // Primary tenant ID is strictly immutable once set - only platform superAdmin can alter it.
    match /clinic_config/{configId} {
      allow read: if true;
      allow create: if false; // Provisioned exclusively via Cloud Functions
      allow update: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        (
          resource != null &&
          isClinicAdmin(resource.data.primaryClinicId) &&
          request.resource.data.primaryClinicId == resource.data.primaryClinicId
        )
      );
      allow delete: if false;
    }

    // 1.7. Private Deployment Configuration (Sensitive Admin UIDs, Webhook secrets, Token hashes)
    // Strictly confidential: Not readable or writable by the public or non-admin users
    match /clinic_config_private/{configId} {
      allow read, write: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        (resource != null && isClinicAdmin(resource.data.primaryClinicId))
      );
    }

    match /clinic_drafts/{clinicId} {
      allow read, write: if isClinicAdmin(clinicId) || (hasRole('editor') && getUserClinicId() == clinicId);
    }

    // 2. Users Collection
    // Patients can only view their own profile. On self-update, role and clinicId are immutable.
    // Staff can read patient profiles; only Clinic Admins can promote roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || (isAuthenticated() && isClinicStaff(resource.data.clinicId));
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['id', 'name', 'displayName', 'email', 'phone', 'createdAt']);
      allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'displayName', 'phone']);
      allow delete: if false;

    }

    // 3. Appointments Collection
    // Strict isolation: Patients can only access their own appointments
    // Staff/Doctors can access appointments for their clinic
    match /appointments/{appointmentId} {
      allow read: if (isAuthenticated() && resource.data.patientId == request.auth.uid) ||
                     (isAuthenticated() && isClinicStaff(resource.data.clinicId));

      // Reservations and settlement are validated by the server's transaction API.
      allow create, update, delete: if false;

    }

    // 4. Inquiries / Leads Collection
    // Public can create (website contact form), but only clinic staff can read/manage
    match /inquiries/{inquiryId} {
      allow create: if false;
      allow read, update: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
      allow delete: if isAuthenticated() && isClinicAdmin(resource.data.clinicId);
    }

    // 5. Conditions, Team, Blogs, Testimonials, FAQs (Public Content)
    // Public read; staff can write
    match /conditions/{conditionId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
    }

    match /teamMembers/{memberId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow create: if isAuthenticated() && isClinicStaff(request.resource.data.clinicId);
      allow update: if isAuthenticated() && isClinicStaff(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if isAuthenticated() && isClinicStaff(resource.data.clinicId);
    }

    // 6. Support Tickets (Scoped by clinicId)
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicStaff(resource.data.clinicId)
      );
      allow create: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        request.isClinicStaff(resource.data.clinicId)
      );
      allow update: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicStaff(resource.data.clinicId)
      );
      allow delete: if false;
    }

    // 7. Global Announcements (Public read, no client write)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false;
    }

    // 8. Invoices (Scoped by clinicId, no client write)
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true ||
        isClinicStaff(resource.data.clinicId)
      );
      allow write: if false;
    }

    // 9. Operator Audit Logs (Server-only via Admin SDK)
    match /operator_audit_log/{logId} {
      allow read, write: if false;
    }

    // 10. Diagnostics check collection
    match /_diag/{diagId} {
      allow read, write: if false;
    }
  }
}
