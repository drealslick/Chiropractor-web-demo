# ==========================================
# Practice OS — Client Environment Variables
# Copy this file to .env.local for local development
# ==========================================

# 1. Firebase Client Configuration
# (Obtained from Firebase Console -> Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_DATABASE_ID=(default)

# 2. Clinic Tenant & Theme Configuration
VITE_CLINIC_ID=your-clinic-slug
VITE_DEFAULT_PRESET=austin

# 3. Stripe Payments (Public publishable key for patient card checkout)
# (Obtained from Stripe Dashboard -> Developers -> API Keys -> Publishable key)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
