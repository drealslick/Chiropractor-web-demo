{
  "name": "practice-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run tests/patient-documents.test.ts",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-practice-review \"vitest run tests/firestore.rules.test.ts tests/security-boundaries.test.ts tests/booking-server.test.ts\"",
    "prepare:clinic": "node scripts/prepare-clinic.cjs",
    "pretest:rules": "npm run build --prefix functions"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "npm@10.9.9",
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "uuid": "^11.1.1",
    "re2": "^1.27.0"
  }
}
