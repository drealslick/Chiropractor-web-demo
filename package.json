{
  "name": "practice-os",
  "private": true,
  "version": "1.0.1",
  "description": "Production-grade chiropractic & physical therapy practice management platform",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc && vite build && tsx scripts/prerender.ts",
    "build:functions": "npm --prefix functions run build",
    "preview": "vite preview",
    "clean": "rm -rf dist functions/lib coverage test-output",
    "migrate:firestore": "tsx scripts/migrate-to-firestore.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src functions/src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"functions/src/**/*.ts\"",
    "test": "node scripts/run-tests.js",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:security": "vitest run tests/security-regressions.test.ts",
    "test:handlers": "vitest run tests/functions-handlers.test.ts",
    "test:ci": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "playwright": "^1.63.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.3.1"
  }
}
