{
  "name": "practice-os-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for Practice OS",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "rm -rf lib && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "resend": "^3.2.0",
    "stripe": "^14.21.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.3.1",
    "uuid": "^11.1.1"
  }
}
