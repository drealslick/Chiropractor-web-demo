# Cloud Functions Environment Variables
# Copy this file to functions/.env and fill in your values

# Secret Setup Token (used once to claim the clinic administrator account)
CLINIC_SETUP_TOKEN=change-this-to-a-secure-random-token-32-chars

# Stripe Payments (from dashboard.stripe.com/apikeys)
# For Test Mode: use sk_test_... (paired with VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...)
# For Live Production: use sk_live_... (paired with VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_WEBHOOK_SECRET

# Set to true so payments process directly on your Stripe account without Connect OAuth
FORCE_DIRECT_STRIPE=true

# Resend Transactional Email (from resend.com/api-keys)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=appointments@your-domain.com

# Twilio Automated SMS (Optional - leave blank if not using SMS reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# App URL for email notifications and links (e.g., https://your-clinic.vercel.app)
APP_URL=https://your-clinic.vercel.app
