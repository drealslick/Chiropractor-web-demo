rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function staff(clinicId) {
      return signedIn() && request.auth.token.clinicId == clinicId
        && request.auth.token.role in ['admin', 'staff'];
    }
    function imageOrDelete() {
      return request.resource == null || (request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024);
    }
    match /clinics/{clinicId}/{allPaths=**} {
      allow read: if true;
      allow write: if staff(clinicId) && imageOrDelete();
    }
    // Tenant-qualified paths are required for all new patient uploads.
    match /patient_records/{clinicId}/{patientId}/{allPaths=**} {
      allow read: if staff(clinicId) || (signedIn() && request.auth.uid == patientId && request.auth.token.clinicId == clinicId);
      allow write: if (staff(clinicId) || (signedIn() && request.auth.uid == patientId && request.auth.token.clinicId == clinicId))
        && (request.resource == null || request.resource.size < 5 * 1024 * 1024);
    }
    // Legacy unscoped paths cannot safely authorize clinic staff.
    match /patients/{patientId}/{allPaths=**} {
      allow read: if signedIn() && request.auth.uid == patientId;
      allow write: if false;
    }
  }
}
