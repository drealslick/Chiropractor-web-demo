rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isClinicStaff(clinicId) {
      return isAuthenticated() && (
        ('superAdmin' in request.auth.token && request.auth.token.superAdmin == true) ||
        ('clinicId' in request.auth.token && request.auth.token.clinicId == clinicId &&
         'role' in request.auth.token && request.auth.token.role in ['staff', 'admin', 'practitioner'])
      );
    }

    function isPatientInClinic(clinicId, patientId) {
      return isAuthenticated()
        && request.auth.uid == patientId
        && 'clinicId' in request.auth.token
        && request.auth.token.clinicId == clinicId;
    }

    function isClinicAdmin(clinicId) {
      return isAuthenticated() && (
        ('superAdmin' in request.auth.token && request.auth.token.superAdmin == true) ||
        ('clinicId' in request.auth.token && request.auth.token.clinicId == clinicId &&
         (('role' in request.auth.token && request.auth.token.role == 'admin') ||
          ('admin' in request.auth.token && request.auth.token.admin == true)))
      );
    }

    // Public images must not accept active formats (SVG/XML), which can
    // execute script when served from an untrusted public URL.
    function isValidImage() {
      return request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp', 'image/gif']
        && request.resource.size < 5 * 1024 * 1024;
    }

    function isValidDocument() {
      return (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Public clinic media (headshots, hero images, blog thumbnails, clinic photos)
    match /clinics/{clinicId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isClinicStaff(clinicId) && isValidImage();
    }

    // Private clinic staff documents (staff credentials, licenses, private contracts - Admin-only)
    match /clinics/{clinicId}/staff/{allPaths=**} {
      allow read: if isClinicAdmin(clinicId);
      allow write: if isClinicAdmin(clinicId) && isValidDocument();
    }

    // Patient records / intake uploads (strictly private to patient and staff of same clinic)
    match /patients/{clinicId}/{patientId}/{allPaths=**} {
      allow read: if isPatientInClinic(clinicId, patientId) || isClinicStaff(clinicId);
      allow create, update: if (isPatientInClinic(clinicId, patientId) || isClinicStaff(clinicId))
        && isValidDocument();
      allow delete: if isPatientInClinic(clinicId, patientId) || isClinicAdmin(clinicId);
    }

    // Legacy unscoped uploads are read-only for their actual owner until
    // migrated to /patients/{clinicId}/{patientId}/... .
    // No more unscoped writes or unchecked MIME/size evaluations on reads.
    match /patients/{patientId}/{allPaths=**} {
      allow read: if isAuthenticated() && request.auth.uid == patientId;
      allow write: if false;
    }
  }
}
